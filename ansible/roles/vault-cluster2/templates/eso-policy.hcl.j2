# Read-only policy for External Secrets Operator — {{ item.path }} only.
# Generated by ansible/roles/vault-cluster2. Do not hand-edit; change defaults/main.yml.
# Paths are EXACT (no globs). Each entry grants only its own service's KV v2 data and metadata.
path "secret/data/{{ item.path }}" {
  capabilities = ["read"]
}

path "secret/metadata/{{ item.path }}" {
  capabilities = ["read", "list"]
}
